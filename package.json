{
  "name": "open-video",
  "version": "0.1.0",
  "description": "本地视频转文本管理系统：哔哩哔哩音频下载 + 本地语音转写 + 说话人分离",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @open-video/web dev",
    "build": "pnpm --filter @open-video/web build",
    "start": "pnpm --filter @open-video/server start",
    "setup:bin": "node scripts/setup-binaries.mjs",
    "setup:model": "node scripts/setup-model.mjs",
    "docs:dev": "pnpm --filter @open-video/docs dev",
    "docs:build": "pnpm --filter @open-video/docs build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@hono/node-server": "^1.14.0",
    "autocorrect-node": "^2.14.0",
    "element-plus": "^2.14.7",
    "hono": "^4.7.0",
    "sherpa-onnx-node": "^1.13.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "^1.13.8",
    "sherpa-onnx-darwin-x64": "^1.13.8",
    "sherpa-onnx-linux-x64": "^1.13.8",
    "sherpa-onnx-win-x64": "^1.13.8"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=22.5",
    "pnpm": ">=8.0.0"
  }
}
